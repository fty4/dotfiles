[commit]
        gpgsign = true

[core]
        autocrlf = false
        eol = lf
        excludesFile = ~/.gitignore
        ignorecase = false

[gpg]
        program = /opt/homebrew/bin/gpg

[init]
        defaultBranch = main

[user]
        name = {{ .name }}
        email = {{ .email }}
        signingKey = {{ onepasswordRead "op://Personal/gpg/signingkey" }}

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
